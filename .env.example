# Required for PostgreSQL. Replace with a strong, unique random value; do not commit .env.
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# USGS live source and monotonic polling cadence
USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
POLL_SECONDS=60
POLL_TOLERANCE_SECONDS=5
USGS_TIMEOUT_SECONDS=8

# Persistent source-response archive mounted by the productor service
SOURCE_ARCHIVE_DIR=/data/source-archives

# Historical replay pacing; use 0 for an unpaced controlled load
REPLAY_INTERVAL_SECONDS=0
